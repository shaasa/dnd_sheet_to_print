# OpenRouter API Configuration (piano gratuito: 50 richieste/giorno)
# Ottieni la chiave su https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Modello da usare — scegli un modello free su https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=2048
# Identificativi del sito (opzionali ma raccomandati da OpenRouter per rate limit policy)
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME="DnD Sheet Generator"

# Debug Mode (per sviluppo - rimuovi in produzione)
DEBUG_MODE=true

# Optional: OpenAI API Configuration
# OPENAI_API_KEY=your_openai_api_key_here